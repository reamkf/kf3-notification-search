{
  "name": "basic",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build && vite build --config vite.ssg.config.ts && bun scripts/assert-build-output.ts",
    "preview": "$npm_execpath run build && wrangler dev",
    "restore:dev": "wrangler dev --config wrangler.restore.toml --ip 127.0.0.1 --port 8790",
    "seed:dummy": "bun scripts/seed-dummy-data.js",
    "seed:production": "bun scripts/fetch-production-data.js",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "test": "bun run test:unit && bun run test:worker",
    "test:e2e": "playwright test",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts",
    "test:unit": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "bun run seed:dummy && bun run seed:production && lefthook install"
  },
  "dependencies": {
    "@hono/vite-ssg": "^0.3.3",
    "dayjs": "^1.11.21",
    "hono": "^4.12.32",
    "honox": "^0.1.60",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "happy-dom": "^20.11.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
