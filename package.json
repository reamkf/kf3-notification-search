{
  "name": "basic",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "preview": "$npm_execpath run build && wrangler dev",
    "restore:dev": "wrangler dev --config wrangler.restore.toml --ip 127.0.0.1 --port 8790",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@hono/vite-ssg": "^0.3.3",
    "dayjs": "^1.11.21",
    "hono": "^4.12.32",
    "honox": "^0.1.60",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
