{
  "name": "basic",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build --mode client && vp build && vp build --mode ssg && bun scripts/assert-build-output.ts",
    "preview": "vp run build && wrangler dev",
    "restore:dev": "wrangler dev --config wrangler.restore.toml --ip 127.0.0.1 --port 8790",
    "seed:dummy": "bun scripts/seed-dummy-data.js",
    "seed:production": "bun scripts/fetch-production-data.js",
    "deploy": "vp run build && wrangler deploy",
    "test": "vp test --project unit && vp test --project worker",
    "test:e2e": "playwright test",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts",
    "test:unit": "vp test --project unit",
    "test:worker": "vp test --project worker",
    "test:watch": "vp test --project unit --watch",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "prepare": "bun run seed:dummy && bun run seed:production && vp config --no-agent"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@hono/vite-ssg": "^0.3.3",
    "dayjs": "^1.11.23",
    "hono": "^4.13.5",
    "honox": "^0.1.61",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260827.1",
    "@hono/vite-build": "^1.11.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "happy-dom": "^20.11.8",
    "tailwindcss": "^4.3.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.4.0"
}
